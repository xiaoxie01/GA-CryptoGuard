{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GADecision",
  "type": "object",
  "required": ["symbol", "analysis_time_utc", "decision", "signal_grade", "confidence", "summary", "counter_evidence", "has_trade_plan", "suggested_actions", "risk_notes", "timeframe_context", "alignment", "htf_conflict", "market_reason_codes"],
  "properties": {
    "symbol": {"type": "string"},
    "analysis_time_utc": {"type": "integer", "minimum": 1, "description": "unix millis, 必须为正整数，与 snapshot.analysis_time_utc 一致"},
    "decision": {
      "type": "string",
      "enum": ["trade_plan_available", "wait_for_pullback", "wait_for_breakout", "wait_for_reclaim", "avoid_chop", "no_edge", "monitor_only"]
    },
    "signal_grade": {"type": "string", "enum": ["S", "A", "B", "C", "D"]},
    "market_bias": {"type": "string", "enum": ["bullish", "bearish", "neutral", "mixed", "unknown"]},
    "trend_stage": {"type": "string", "enum": ["early", "middle", "late", "range", "transition", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "counter_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk_notes": {"type": "array", "items": {"type": "string"}},
    "has_trade_plan": {"type": "boolean"},
    "trade_plan": {
      "type": ["object", "null"],
      "properties": {
        "side": {"type": "string", "enum": ["LONG", "SHORT"]},
        "entry_type": {"type": "string", "enum": ["market", "limit", "trigger"]},
        "entry_price": {"type": ["number", "null"]},
        "trigger_price": {"type": ["number", "null"]},
        "stop_loss": {"type": "number"},
        "take_profits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["price", "ratio"],
            "properties": {
              "price": {"type": "number"},
              "ratio": {"type": "number"}
            }
          }
        },
        "risk_percent": {"type": "number"},
        "invalid_condition": {"type": "string"},
        "reason": {"type": "string"},
        "entry_trigger_confirmation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["type", "timeframe", "event_type", "direction", "candle_close_time", "price", "source", "symbol"],
          "properties": {
            "type": {"type": "string", "enum": ["closed_candle_confirmation"]},
            "symbol": {"type": "string", "description": "Must equal top-level decision.symbol — cross-symbol matching is forbidden"},
            "timeframe": {"type": "string", "enum": ["1m", "5m", "15m", "1h", "4h"]},
            "event_type": {"type": "string", "enum": ["BOS", "CHOCH", "RECLAIM", "BREAKOUT_RETEST"]},
            "direction": {"type": "string", "enum": ["bullish", "bearish"]},
            "candle_close_time": {"type": "integer", "description": "unix millis"},
            "price": {"type": "number"},
            "source": {"type": "string", "enum": ["price_action", "smc", "deterministic_rule"]}
          }
        }
      }
    },
    "opportunity_watch": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["needed", "direction", "conditions", "invalid_condition"],
      "properties": {
        "needed": {"type": "boolean"},
        "direction": {"type": "string", "enum": ["LONG", "SHORT"]},
        "reason": {"type": ["string", "null"]},
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "side"],
            "properties": {
              "type": {"type": "string", "enum": ["price_below", "close_below", "price_above", "close_above", "pullback", "breakout", "reclaim"]},
              "side": {"type": "string", "enum": ["LONG", "SHORT"]},
              "timeframe": {"type": "string", "enum": ["1m", "5m", "15m", "1h", "4h"]},
              "level": {"type": "number", "minimum": 0},
              "price": {"type": "number", "minimum": 0},
              "tolerance_pct": {"type": "number", "minimum": 0}
            },
            "anyOf": [
              {"required": ["level"]},
              {"required": ["price"]}
            ]
          }
        },
        "invalid_condition": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["type", "side"],
          "properties": {
            "type": {"type": "string", "enum": ["price_below", "close_below", "price_above", "close_above", "pullback", "breakout", "reclaim"]},
            "side": {"type": "string", "enum": ["LONG", "SHORT"]},
            "timeframe": {"type": "string", "enum": ["1m", "5m", "15m", "1h", "4h"]},
            "level": {"type": "number", "minimum": 0},
            "price": {"type": "number", "minimum": 0},
            "tolerance_pct": {"type": "number", "minimum": 0}
          },
          "anyOf": [
            {"required": ["level"]},
            {"required": ["price"]}
          ]
        },
        "expires_minutes": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "suggested_actions": {
      "type": "array",
      "items": {"type": "string", "enum": ["create_paper_order", "create_opportunity_watch", "add_to_watchlist", "ignore", "monitor_only"]}
    },
    "timeframe_context": {
      "type": "object",
      "description": "Phase B (07-03): structured per-timeframe bias/structure/closed/close_time. Fixed keys: 1d/4h/1h/15m only.",
      "additionalProperties": false,
      "required": ["1d", "4h", "1h", "15m"],
      "properties": {
        "1d": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bias", "structure", "closed", "close_time"],
          "properties": {
            "bias": {"type": "string", "enum": ["bullish", "bearish", "neutral", "mixed", "unknown"]},
            "structure": {"type": "string"},
            "closed": {"type": "boolean"},
            "close_time": {"type": "integer", "minimum": 0, "description": "unix millis of last closed candle; 0 when unknown/degraded; must be <= analysis_time_utc when > 0"}
          }
        },
        "4h": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bias", "structure", "closed", "close_time"],
          "properties": {
            "bias": {"type": "string", "enum": ["bullish", "bearish", "neutral", "mixed", "unknown"]},
            "structure": {"type": "string"},
            "closed": {"type": "boolean"},
            "close_time": {"type": "integer", "minimum": 0, "description": "unix millis of last closed candle; 0 when unknown/degraded; must be <= analysis_time_utc when > 0"}
          }
        },
        "1h": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bias", "structure", "closed", "close_time"],
          "properties": {
            "bias": {"type": "string", "enum": ["bullish", "bearish", "neutral", "mixed", "unknown"]},
            "structure": {"type": "string"},
            "closed": {"type": "boolean"},
            "close_time": {"type": "integer", "minimum": 0, "description": "unix millis of last closed candle; 0 when unknown/degraded; must be <= analysis_time_utc when > 0"}
          }
        },
        "15m": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bias", "structure", "closed", "close_time"],
          "properties": {
            "bias": {"type": "string", "enum": ["bullish", "bearish", "neutral", "mixed", "unknown"]},
            "structure": {"type": "string"},
            "closed": {"type": "boolean"},
            "close_time": {"type": "integer", "minimum": 0, "description": "unix millis of last closed candle; 0 when unknown/degraded; must be <= analysis_time_utc when > 0"}
          }
        }
      }
    },
    "alignment": {
      "type": "string",
      "enum": ["aligned", "partial", "countertrend_rebound", "neutral", "unknown"],
      "description": "Phase B (07-03): multi-timeframe alignment vs 1D direction."
    },
    "htf_conflict": {
      "type": "boolean",
      "description": "Phase B (07-03): True when 1D opposes low-TF direction and 4H does not confirm the rebound."
    },
    "market_reason_codes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Phase B (07-03): structured reason codes for audits/reports (htf_conflict, countertrend_rebound, bias_stage_contradiction, overextended, data_incomplete)."
    }
  }
}
